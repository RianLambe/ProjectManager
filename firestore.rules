rules_version = '2';

// This app uses one shared document ("boards/main") for the whole board.
// Anyone signed in (including anonymous sign-in, which the app does
// automatically) can read/write it - that's what makes "open on any PC,
// no login screen" possible. Everything else is locked down.
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/main {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
