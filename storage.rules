rules_version = '2';

// Images attached to tasks live under task-images/. Anyone signed in
// (including the app's automatic anonymous sign-in) can read/write them -
// same "open on any PC, no login screen" model as firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /task-images/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
